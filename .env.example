# QuizExam BF — variables d'environnement
# Copiez ce fichier en .env (local) et configurez les mêmes variables sur Vercel.

# --- Base de données (Supabase Postgres) ---
DATABASE_URL="postgresql://..."

# --- NextAuth (authentification) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="générez-avec-openssl-rand-base64-32"

# --- Google OAuth (V3) — voir docs/google-auth-setup.md ---
# Sans ces variables, le bouton "Continuer avec Google" reste masqué.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Brevo (emails transactionnels, V3) — voir docs/brevo-configuration.md ---
# Sans BREVO_API_KEY, les emails sont journalisés mais non envoyés.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="QuizExam BF"
NEXT_PUBLIC_APP_URL="https://quizexam-bf.app"

# --- Admin ---
ADMIN_EMAIL="giobamos03@gmail.com"
ADMIN_PASSWORD=""

# --- FedaPay (paiements, P5) ---
FEDAPAY_SECRET_KEY=""
FEDAPAY_ENVIRONMENT="sandbox"
FEDAPAY_WEBHOOK_SECRET=""

# --- Observabilité (P6, optionnel) ---
ERROR_WEBHOOK_URL=""
